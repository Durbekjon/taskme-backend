# ---- Database ----
DATABASE_URL="postgresql://user:password@localhost:5432/taskme?schema=public"

# ---- Server ----
PORT=4000
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS="http://localhost:3000"
# Public URL of the Next.js app (used for OAuth redirects).
FRONTEND_URL="http://localhost:3000"

# ---- Auth ----
# REQUIRED. The app refuses to boot without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ---- Meta WhatsApp Cloud API (optional) ----
# When empty, OTPs are logged by the server instead of being sent.
META_WA_ACCESS_TOKEN=""
META_WA_PHONE_NUMBER_ID=""

# ---- Redis / BullMQ ----
REDIS_HOST="localhost"
REDIS_PORT=6379
